---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-slate-900 dark:text-white">No encontramos esta página</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">
      Es posible que la lección haya cambiado de lugar. Vuelve al inicio para elegir una ruta de estudio.
    </p>
    <a href="/" class="mt-8 inline-flex rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">
      Ir al inicio
    </a>
  </div>
</Layout>
